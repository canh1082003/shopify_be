# Order Watchdog Backend Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas / MongoDB 6.0+)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopify_order_watchdog?retryWrites=true&w=majority
DATABASE_URL=mysql://root:password@localhost:3306/shopify_order_watchdog

# Shopify App Credentials (Leave empty to use Sandbox / Demo Mode)
# Create in Shopify Partner Dashboard -> Apps -> Order Watchdog
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_orders,read_fulfillments,write_orders
APP_URL=http://localhost:5000

# Security (32-byte hex key for AES-256-GCM token encryption)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email Notification Provider (SMTP credentials for automated alert delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=alerts@orderwatchdog.app

# Monitoring Frequency
MONITORING_INTERVAL_MS=30000
