# StockPilot Backend Configuration

# Server
PORT=5000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# Database (MongoDB Atlas / MongoDB 6.0+)
MONGODB_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/shopify_stockpilot?retryWrites=true&w=majority

# Shopify App Credentials (Leave empty to use Sandbox / Demo Mode)
# Create in Shopify Partner Dashboard -> Apps -> StockPilot
SHOPIFY_API_KEY=
SHOPIFY_API_SECRET=
SHOPIFY_SCOPES=read_products,read_inventory,read_orders,read_locations
APP_URL=http://localhost:5000

# Security (32-byte hex key for AES-256-GCM token encryption)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Email Notification Provider (SMTP credentials for automated alert delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
NOTIFICATION_FROM_EMAIL=alerts@stockpilot.io

# Monitoring Frequency
MONITORING_INTERVAL_MS=30000
