// Order Watchdog - Prisma Database Schema
// Multi-tenant architecture for Shopify App Store production deployment

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Shop {
  id              String           @id @default(uuid())
  shopDomain      String           @unique
  shopifyShopId   String?          @unique
  name            String
  email           String?
  timezone        String           @default("UTC")
  currency        String           @default("USD")
  plan            String           @default("basic")
  installedAt     DateTime         @default(now())
  uninstalledAt   DateTime?
  isDemo          Boolean          @default(false)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  sessions        ShopifySession[]
  orders          Order[]
  alerts          Alert[]
  settings        Settings?
  notificationLogs NotificationLog[]

  @@index([shopDomain])
}

model ShopifySession {
  id                   String    @id @default(uuid())
  shopId               String
  shop                 Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  sessionType          String    @default("offline") // "offline" | "online"
  encryptedAccessToken String
  iv                   String    // Initialization vector for AES-256-GCM
  authTag              String    // Auth tag for AES-256-GCM verification
  scope                String    // e.g. "read_orders,read_fulfillments,write_orders"
  expiresAt            DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@index([shopId])
}

model Order {
  id                  String    @id @default(uuid())
  shopId              String
  shop                Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  shopifyOrderId      String    // e.g. "gid://shopify/Order/123456789"
  orderNumber         String    // e.g. "#1001"
  name                String    // e.g. "#1001"
  customerName        String?   // Customer name (subject to Shopify protected customer data access)
  customerEmail       String?
  createdAt           DateTime  // Order placement timestamp in Shopify
  processedAt         DateTime?
  cancelledAt         DateTime?
  financialStatus     String    // "paid" | "authorized" | "pending" | "partially_refunded" | "refunded" | "voided"
  fulfillmentStatus   String    // "unfulfilled" | "partial" | "fulfilled" | "restocked"
  totalAmount         Float     @default(0.0)
  currencyCode        String    @default("USD")
  totalItems          Int       @default(1)
  fulfillableQuantity Int       @default(1) // Remaining items awaiting fulfillment
  lineItemsJson       String    @default("[]") // JSON representation of items
  deadline            DateTime? // Computed fulfillment deadline
  isOverdue           Boolean   @default(false)
  overdueMinutes      Int       @default(0)
  shopifyUrl          String?   // Admin URL link: https://admin.shopify.com/store/{shop}/orders/{id}
  lastSyncedAt        DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  alerts              Alert[]

  @@unique([shopId, shopifyOrderId])
  @@index([shopId, fulfillmentStatus])
  @@index([shopId, financialStatus])
  @@index([shopId, isOverdue])
  @@index([shopId, createdAt])
}

model Alert {
  id              String    @id @default(uuid())
  shopId          String
  shop            Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderNumber     String
  severity        String    // "warning" | "critical" | "resolved"
  status          String    // "active" | "acknowledged" | "resolved"
  reason          String
  elapsedHours    Float     @default(0.0)
  thresholdHours  Float     @default(24.0)
  createdAt       DateTime  @default(now())
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?

  notificationLogs NotificationLog[]

  @@index([shopId, status])
  @@index([shopId, severity])
  @@index([orderId, status])
}

model Settings {
  id                    String    @id @default(uuid())
  shopId                String    @unique
  shop                  Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  overdueThresholdHours Float     @default(24.0) // 12, 24, 48 or custom
  warningLeadTimeHours  Float     @default(4.0)  // Warn 4 hours before deadline
  emailEnabled          Boolean   @default(true)
  notificationEmail     String    @default("merchant@example.com")
  digestFrequency       String    @default("immediate") // "immediate" | "daily" | "hourly"
  autoAcknowledge       Boolean   @default(false)
  excludeTags           String    @default("[]") // JSON array of Shopify order tags to exclude
  updatedAt             DateTime  @updatedAt
}

model NotificationLog {
  id             String    @id @default(uuid())
  shopId         String
  shop           Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  alertId        String?
  alert          Alert?    @relation(fields: [alertId], references: [id], onDelete: SetNull)
  recipient      String
  subject        String
  deliveryStatus String    // "sent" | "failed" | "simulated_no_credentials"
  errorMessage   String?
  sentAt         DateTime  @default(now())

  @@index([shopId, sentAt])
}
